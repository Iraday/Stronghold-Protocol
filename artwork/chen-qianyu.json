  "details": [
    {
      "id": "portrait",
      "label": "Portrait identity / 立绘",
      "expected": "Keep the owner's supplied illustration, avatar crop and portrait crop. A sprite edit must not silently replace these."
    },
    {
      "id": "eyes",
      "label": "Eyes / 眼睛",
      "expected": "Gray/silver irises with thin vertical RED slit pupils in BOTH eyes, not red-filled irises. Preserve closed-eye poses and the smile.",
      "reference": ".cache/artwork/chen-qianyu/references/eyes.png"
    },
    {
      "id": "horns",
      "label": "Horn roots / 角根",
      "expected": "Blue horn middles and dark tips; rosy pink where every horn meets the hair, matching front and back.",
      "reference": ".cache/artwork/chen-qianyu/references/eyes.png"
    },
    {
      "id": "hair",
      "label": "Hair / 头发",
      "expected": "Soft charcoal/light black, neutral highlights, not deep navy-black or bright gray. All fringe/ponytail pieces should agree.",
      "reference": ".cache/artwork/chen-qianyu/references/eyes.png"
    },
    {
      "id": "gloves",
      "label": "Gloves / 手套",
      "expected": "Lighter blue full gloves in every grip and finger pose; dark lower sleeves remain separate.",
      "reference": ".cache/artwork/chen-qianyu/references/outfit.png"
    },
    {
      "id": "jacket",
      "label": "Jacket / 短外套",
      "expected": "Light-blue cropped jacket, shorter than original Ch'en's coat. Black lower sleeves. Check both sides during attacks.",
      "reference": ".cache/artwork/chen-qianyu/references/outfit.png"
    },
    {
      "id": "skirt",
      "label": "Full skirt / 完整裙摆",
      "expected": "Wide white pleated skirt around both hips, not a dangling center panel or shorts. White pleats remain exposed at side edges and hem.",
      "reference": ".cache/artwork/chen-qianyu/references/apron.png"
    },
    {
      "id": "apron",
      "label": "Partial apron / 浅绿围裙",
      "expected": "Pale sage apron partially covers the FRONT skirt; silver utility accents remain legible. Back skirt stays white, with no apron.",
      "reference": ".cache/artwork/chen-qianyu/references/apron.png"
    },
    {
      "id": "stockings",
      "label": "Stockings / 长袜",
      "expected": "Both lower legs are covered by long dark stockings in front AND back. Bare thighs may show below the hem; no bare lower-leg patch.",
      "reference": ".cache/artwork/chen-qianyu/references/outfit.png"
    },
    {
      "id": "neckline",
      "label": "Back neckline / 背面领口",
      "expected": "A thin collar, not a large blue hoodie behind the neck. Flat blue jacket back remains.",
      "reference": ".cache/artwork/chen-qianyu/references/back.png"
    },
    {
      "id": "motion",
      "label": "Moving cloth / 动态布料",
      "expected": "Watch a continuous Idle → Attack → Skill → Start sequence, in slow motion too. Skirt follows the body, flexes with legs, never stays on the ground or stretches while the body enters."
    },
    {
      "id": "integrity",
      "label": "Unchanged details / 未改动部分",
      "expected": "Weapons, face skin, smile, unrelated atlas regions and non-cloth animation tracks are unchanged. Review at actual in-game scale as well as zoomed."
    }
  ],
